{
    "manifest_version":3,
    "name":"summerizer",
    "version":"1.0",
    "icons":{
        "32":"icon32.png"
    },
    "permissions": [
        "storage",
    "scripting",
    "activeTab",
    "tabs"
    ],
    "background":{
        "service_worker":"background.js"
        
    },
    "content_scripts":[
        {
            "matches":[ "<all_urls>" ],
            "js":[ "content.js" ],
            "run_at": "document_idle"
        }
    ],
    "action":{
        
        "default_popup":"index.html"
    },
    
    "host_permissions":[ "<all_urls>" ]
}